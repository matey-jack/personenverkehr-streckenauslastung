root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
# Kotlin coding conventions (https://kotlinlang.org/docs/coding-conventions.html);
# less line-wrapping than ktlint's default "ktlint_official" style.
ktlint_code_style = intellij_idea
max_line_length = 120
# Files with multi-line SQL strings passed inline as call arguments suppress the "wrapping"
# rule with @file:Suppress("ktlint:standard:wrapping"), which keeps those calls compact.
